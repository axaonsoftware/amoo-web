# Server
PORT=4000
NODE_ENV=development

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=amoo_db

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change_me_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=30d
RESET_TOKEN_EXPIRES_MIN=15

# Frontend origin (CORS) — comma separated for multiple
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Uploads (bytes)
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info
