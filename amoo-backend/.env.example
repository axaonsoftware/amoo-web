# ============================================================
#  Amoo Guru — backend environment
#  Copy to .env and fill in. NEVER commit .env.
#  Values marked [PROD REQUIRED] make the server refuse to boot when
#  NODE_ENV=production and they are missing or left at the default.
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development

# Public base URL of THIS API. Used for gateway webhook registration and
# absolute asset URLs — NOT for links emailed to humans (see CLIENT_URL).
APP_URL=http://localhost:4000

# ---- Frontend origins ----
# CORS allow-list. Comma separated, exact origins (scheme + host + port).
# [PROD REQUIRED] env.js throws if this is "*" in production.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001

# Public base URL of the Next.js site. EVERY link in an email is built from
# this: /verify-email, /user-dashboard, password flows. Defaults to the first
# CLIENT_ORIGIN entry, so you usually need not set it — override only when the
# browser origin and the public link origin differ.
# [PROD REQUIRED] env.js throws if this resolves to localhost in production,
# because every verification email would then contain a dead link.
CLIENT_URL=

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password    # CHANGE THIS — never deploy a weak password
DB_NAME=amoo_db

# ---- Auth ----
# [PROD REQUIRED] Generate with:  openssl rand -base64 48
# env.js throws if either is left at its dev default in production.
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_secret_too
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d
RESET_TOKEN_EXPIRES_MIN=15

# Consecutive failed logins before a temporary lockout.
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ---- Cron ----
# node-cron syntax: minute hour day month weekday. Default 02:00 daily.
#   "0 0 * * *"    = daily at midnight
#   "*/30 * * * *" = every 30 minutes (useful for testing)
CRON_SCHEDULE=0 2 * * *
# The scheduler runs IN-PROCESS. Under PM2 cluster mode only worker 0 starts it
# (see src/cron/index.js). On a multi-replica deployment set this to "false" on
# every replica but one, or the job runs concurrently on all of them.
CRON_ENABLED=true

# ---- Uploads ----
MAX_FILE_SIZE=5242880

# ---- Logging ----
LOG_LEVEL=info

# ---- Object storage (S3-compatible) ----
# Leave S3_ENABLED=false to store uploads on local disk. In a container that
# means mounting a volume at /app/uploads, or files vanish on redeploy.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=            # set for MinIO / non-AWS S3-compatible storage
S3_PUBLIC_BASE=

# ---- Email (SMTP) ----
# When EMAIL_ENABLED=false, sends are skipped and dev endpoints return the OTP
# or verification token directly in the response instead.
# Required in production for email verification — which gates booking and
# payment through verifiedRequired — and for password-reset OTPs.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@amooguru.com

# ---- Payments ----
# [PROD REQUIRED] env.js throws if this is still "mock" in production: the
# webhook skips signature verification for the mock gateway, which would leave
# an unauthenticated endpoint able to mark bookings paid.
PAYMENT_GATEWAY=mock            # mock | razorpay | stripe
PAYMENT_KEY=
PAYMENT_SECRET=

# [PROD REQUIRED] Without it the webhook has no signature verification.
PAYMENT_WEBHOOK_SECRET=

# Required when PAYMENT_GATEWAY=razorpay.
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Tracing (optional) ----
# Tracing is entirely optional: if the packages are missing or the exporter
# fails, the API logs a warning and serves traffic normally.
# Set to an OTLP collector base URL to export spans (Jaeger, Tempo, Datadog).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Print every span to stdout — very noisy, debugging only.
OTEL_CONSOLE_EXPORTER=false
# Hard-disable tracing regardless of the above.
OTEL_SDK_DISABLED=false

# ============================================================
#  Production checklist
# ============================================================
#  NODE_ENV=production
#  JWT_SECRET / JWT_REFRESH_SECRET     strong, unique, rotated
#  DB_PASSWORD                         strong; DB not publicly reachable
#  CLIENT_ORIGIN                       exact origins, never "*"
#  CLIENT_URL                          public https:// site URL
#  PAYMENT_GATEWAY + PAYMENT_WEBHOOK_SECRET + Razorpay keys
#  EMAIL_ENABLED=true + working SMTP   (verification gates booking/payment)
#  HTTPS terminated upstream           (nginx / Cloudflare / platform).
#                                      Auth cookies are SameSite=None; Secure
#                                      in production and are DROPPED over http.
#  trust proxy                         enabled automatically in production
# ============================================================
