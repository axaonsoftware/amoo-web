# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password    # CHANGE THIS — do not use a weak/guessable password
DB_NAME=amoo_db

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change_me_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=30d
RESET_TOKEN_EXPIRES_MIN=15

# Frontend origin (CORS) — comma separated for multiple
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Account lockout (consecutive failed attempts before temp ban)
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15

# Uploads (bytes)
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info

# ---- Production-only (set these in production) ----

# In production:
#   NODE_ENV=production
#   CLIENT_ORIGIN must list specific origins, NOT "*"
#   JWT_SECRET / JWT_REFRESH_SECRET must be strong random values
#   A reverse proxy (Nginx / Railway / Cloudflare) handles HTTPS termination
#   app.set("trust proxy") is enabled automatically when NODE_ENV=production

# Object storage (S3-compatible). Empty = store uploads on local disk.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE=

# Email (OTP / verification). Empty = dev mode (tokens returned in response).
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@amooguru.com

# Payments (razorpay | stripe | mock)
PAYMENT_GATEWAY=mock
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
