# Amoo Guru — Backend Environment Configuration
# Copy this file to .env and fill in the values before running in production.

# ── Server ──────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ── Reverse proxy ───────────────────────────────────
# Number of trusted proxy hops between this app and the client (nginx sits in
# front). 1 in production (default), 0 in local development.
TRUST_PROXY=1

# ── Database ───────────────────────────────────────
# Either set DATABASE_URL for a full connection string,
# or set DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME individually.
DATABASE_URL=postgresql://user:password@localhost:5432/amoo_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=
DB_NAME=amoo_db
# Require TLS for the DB connection. Use true for managed databases (RDS etc.) —
# pg also honours sslmode=require inside DATABASE_URL.
DB_SSL=false

# ── JWT ────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_use_a_strong_random_value
JWT_REFRESH_SECRET=change_me_use_a_different_strong_random_value
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d
RESET_TOKEN_EXPIRES_MIN=15

# ── Client ─────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# Use * only in development; set specific origins in production.
CLIENT_ORIGIN=http://localhost:3000
# Public base URL of the Next.js frontend (used in email links).
CLIENT_URL=http://localhost:3000
# Public base URL of this API (used in webhook callbacks, asset URLs).
# REQUIRED in production — Razorpay webhooks use this URL to reach the server.
APP_URL=http://localhost:4000

# ── Rate Limiting ──────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Stricter limit for auth endpoints (login, register, forgot-password)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
# Registration-specific limit (1 hour window)
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=10

# ── Account Lockout ────────────────────────────────
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15

# ── OTP ────────────────────────────────────────────
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# ── File Upload ────────────────────────────────────
MAX_FILE_SIZE=5242880

# ── S3 / Object Storage ───────────────────────────
# Set S3_ENABLED=true to use S3-compatible storage instead of local disk.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE=

# ── Email (nodemailer / SMTP) ──────────────────────
# REQUIRED true in production (boot aborts if email is disabled there).
# EMAIL_HOST is required when email is enabled.
# IMPORTANT: Set EMAIL_ENABLED=true in production — forgot-password and
# verify-email depend on SMTP and will 500 without it.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@amooguru.com

# ── Payment Gateway ────────────────────────────────
# 'mock' and 'stripe' are REJECTED in production — set razorpay and provide keys.
# Set PAYMENT_GATEWAY=razorpay and fill in the keys below.
# Payloads must go through the webhook for status changes.
# IMPORTANT: PAYMENT_KEY and PAYMENT_SECRET are aliases that map to the
# Razorpay keys. In production, set PAYMENT_GATEWAY=razorpay and provide
# the Razorpay keys below.
PAYMENT_GATEWAY=mock
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── API docs (Swagger UI) ──────────────────────────
# Served at /api-docs in all environments except production, where it must be
# enabled explicitly:
# ENABLE_SWAGGER=true

# ── Debug ──────────────────────────────────────────
# When true, OTPs and verification tokens are returned in API responses.
# NEVER enable this in production or on any internet-facing host.
DEV_DEBUG_TOKENS=false

# ── Monitoring ─────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
CRON_SCHEDULE=0 2 * * *

# ── WebSocket ──────────────────────────────────────
WS_MAX_CONNECTIONS_PER_USER=3
WS_MAX_MESSAGES_PER_SECOND=10

# ── Production Admin ───────────────────────────────
# Used by `npm run init:admin` to create the single production admin account.
# EMAIL is required. PASSWORD is required unless GENERATE_ADMIN_PASSWORD=true.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to "true" to auto-generate a 24-char random password (printed on first run).
GENERATE_ADMIN_PASSWORD=false