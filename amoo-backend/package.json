{
  "name": "amoo-backend",
  "version": "1.0.0",
  "description": "Express + MySQL backend for the Amoo Guru spiritual/astrology platform",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test tests/helpers.test.js tests/validate.test.js && node --test tests/integration.test.js",
    "test:unit": "node --test tests/helpers.test.js tests/validate.test.js",
    "test:int": "node --experimental-test-module-mocks --test tests/integration.test.js",
    "seed": "node src/seed.js",
    "migrate": "node src/migrate.js",
    "pm2": "pm2 start ecosystem.config.js --env production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
