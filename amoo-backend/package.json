{
  "name": "amoo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + PostgreSQL backend for the Amoo Guru spiritual/astrology platform",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test tests/helpers.test.js tests/validate.test.js tests/paths.test.js tests/secrets.test.js tests/security_audits.test.js && node --test tests/integration.test.js",
    "test:unit": "node --test tests/helpers.test.js tests/validate.test.js tests/paths.test.js tests/secrets.test.js tests/security_audits.test.js",
    "test:int": "node --experimental-test-module-mocks --test tests/integration.test.js",
    "seed": "node src/seed.js",
    "migrate": "node src/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.0",
    "razorpay": "^2.9.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
