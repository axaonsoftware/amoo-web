# ---- Required (build fails without these) ----

# Copy from amoo-backend/.env — same secret is needed for middleware JWT verification
JWT_SECRET=

# Base URL of the Express API (must match backend's CLIENT_ORIGIN)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Contact & branding (used in UI components)
NEXT_PUBLIC_SITE_NAME=Amoo Guru
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=contact@amooguru.com

# ---- Optional ----

# Sentry error tracking (get from https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
