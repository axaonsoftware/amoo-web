# Copy to .env.local for local development:
#   cp .env.local.example .env.local
#
# Base URL of the Express API. Must be an ORIGIN the backend lists in its own
# CLIENT_ORIGIN (see amoo-backend/.env.example) or CORS will reject the browser's
# preflight — auth cookies and the CSRF token both ride on these requests.
#
# NEXT_PUBLIC_ is required: lib/api.ts runs in the browser, and Next.js only
# inlines env vars with that prefix into client bundles. This value is public —
# never put a secret here.
#
# Leave unset to fall back to http://localhost:4000 (the backend's default PORT).
NEXT_PUBLIC_API_URL=http://localhost:4000
