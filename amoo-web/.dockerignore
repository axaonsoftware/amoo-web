# Dependencies — never ship host node_modules into the image. They are built
# inside the Dockerfile from the lockfile, and copying Windows-built native
# binaries (sharp, @tailwindcss/oxide) over the Linux ones breaks the build.
node_modules

# Build output
.next
.next-build
out
build

# Runtime env — contains dev secrets and overrides the ARG/ENV build values
.env
.env.local
.env*.local

# VCS / tooling
.git
.gitignore
.github
Dockerfile
.dockerignore

# Test / docs
tests
e2e
playwright.config.ts
*.md

# Misc artifacts
*.zip
*.log
*.tsbuildinfo
next-env.d.ts
